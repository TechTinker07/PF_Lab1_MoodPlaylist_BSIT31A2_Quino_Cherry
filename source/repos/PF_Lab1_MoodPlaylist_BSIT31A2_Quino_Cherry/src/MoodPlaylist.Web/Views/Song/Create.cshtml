@model MoodPlaylist.SQLite.Repository.Models.Song

<div class="container py-4 text-white">
    <h2>Add Song</h2>

    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="PlaylistId" />

        <div class="mb-3">
            <label class="form-label">Song Title</label>
            <input asp-for="Title" class="form-control bg-dark text-white border-0" />
        </div>

        <div class="mb-3">
            <label class="form-label">YouTube URL</label>
            <input asp-for="Url" class="form-control bg-dark text-white border-0" />
        </div>

        <button type="submit" class="btn btn-success">Add Song</button>
        <a asp-controller="Playlist" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
